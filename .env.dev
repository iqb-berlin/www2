# Image Registry Path
## Docker Hub:       (aka registry-1.docker.io/) leave REGISTRY_PATH value empty!
## Docker Hub Proxy: scm.cms.hu-berlin.de:443/iqb/dependency_proxy/containers/
REGISTRY_PATH=

# Server
SERVER_NAME=localhost

# Ports
HTTP_PORT=8080

# IT section (/it/)
## Host directory holding the ClickOnce deployment trees (one folder per app)
DOWNLOADS_DIR=./downloads
## Token the LAN scanner sends as "Authorization: Bearer ..." to POST /it/api/pcs
PC_UPDATE_TOKEN=dev-pc-token-not-for-production
## Optional comma separated IPv4 CIDRs allowed to update the PC list (empty = any)
PC_UPDATE_ALLOW_CIDRS=
## Number of PCs in the pool, used for the "% frei" figure
PC_MAX=29
## Per-person upload tokens "name:token,name:token" for PUT /it/api/apps/<App>
UPLOAD_TOKENS=dev:dev-upload-token-not-for-production
## Maximum size of one app upload (zip) in MB
UPLOAD_MAX_MB=500
