# Image Registry Path
## Docker Hub:       (aka registry-1.docker.io/) leave REGISTRY_PATH value empty!
## Docker Hub Proxy: scm.cms.hu-berlin.de:443/iqb/dependency_proxy/containers/
REGISTRY_PATH=

# Ingress
## The Server Name and the TLS Certificates Resolvers are defined and configured in the Traefik project.
## 'SERVER_NAME' and 'TLS_CERTIFICATE_RESOLVER' have to be in sync with the 'SERVER_NAME' and 'TLS_CERTIFICATE_RESOLVER'
## in the '.env.traefik' file located at TRAEFIK_DIR (see below)!
SERVER_NAME=base_domain.org
# Exact Traefik container IP/CIDR as seen by nginx (prefer /32).
# Default trusts only loopback for direct local development. Configure for production.
# Never use 0.0.0.0/0. Traefik must also reject untrusted forwarded headers.
TRUSTED_PROXY_CIDR=127.0.0.1/32
TRAEFIK_DIR=

## TLS_CERTIFICATE_RESOLVER Settings:
### Leave it empty for user-defined certificates, or choose
### 'acme', if you want to use an acme-provider, like 'Let's Encrypt' or 'Sectigo'
TLS_CERTIFICATE_RESOLVER=

# IT section (/it/)
## Host directory holding the ClickOnce deployment trees (one folder per app).
## Must be writable by uid 1000 (the API container's user) and readable by everyone:
##   mkdir -p /srv/www2/downloads && chown 1000:1000 /srv/www2/downloads
DOWNLOADS_DIR=./downloads

## Token the LAN scanner sends as "Authorization: Bearer <token>" when it
## POSTs the JSON list of free PCs to https://SERVER_NAME/it/api/pcs
## Generate with: openssl rand -hex 32
PC_UPDATE_TOKEN=

## Optional comma separated IPv4 CIDRs the PC list may be updated from (empty = any address, token only)
PC_UPDATE_ALLOW_CIDRS=

## Number of PCs in the pool, used for the "% frei" figure
PC_MAX=29

## One upload token per person, "name:token,name:token". Each name shows up in the
## logs and in the "publishedBy" field of the app. Generate tokens with: openssl rand -hex 32
UPLOAD_TOKENS=

## Maximum size of one app upload (zip of a Visual Studio ClickOnce publish folder) in MB
UPLOAD_MAX_MB=500
